# ARAMYA environment — copy to .env.local for local development.
# Never commit real secrets; .env* is gitignored.

# --- Database (PostgreSQL) ---------------------------------------------------
# Local docker compose: postgres://aramya:aramya@localhost:5432/aramya_dev
DATABASE_URL=postgres://aramya:aramya@localhost:5432/aramya_dev
# Set for managed Postgres hosts that require TLS: require | verify-ca | verify-full
# DATABASE_SSL=require
# DATABASE_POOL_MAX=10

# --- Listing & payments ------------------------------------------------------
# When true, a lapsed listing subscription hides a trainer from discovery.
LISTING_FEE_REQUIRED=false
# When true, Razorpay booking payments, payouts and refunds are active.
BOOKING_PAYMENTS_ENABLED=false

# --- Admin console allowlist (comma-separated contacts) ----------------------
# ADMIN_CONTACTS=9999000001,9999000002

# --- Media storage -----------------------------------------------------------
# Local disk (dev): STORAGE_DRIVER=local, STORAGE_LOCAL_DIR=.aramya-uploads
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.aramya-uploads
# S3-compatible (prod): STORAGE_DRIVER=s3 + S3_BUCKET, S3_REGION, S3_ENDPOINT,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_PUBLIC_BASE_URL

# --- Razorpay (optional; MOCK mode is used when keys are absent) -------------
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# --- MSG91 SMS (optional) ----------------------------------------------------
# MSG91_AUTH_KEY=xxx
# MSG91_SENDER_ID=ARAMYA
# MSG91_TEMPLATE_ID=xxx
